---
import '../styles/styles.css';
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";

export interface Props {
  title: string;
}

const { title } = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- ❌ DISABLED: causes state bugs with SPA + Alpine -->
    <!-- <meta name="view-transition" content="same-origin" /> -->

    <!-- Alpine -->
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <!-- IMPORTANT: reset Alpine state on navigation -->
    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        document.querySelectorAll("[x-data]").forEach((el) => {
          if (el.__x) {
            el.__x.$data.isOpen = false;
            el.__x.$data.trailerOpen = false;
            el.__x.$data.imageOpen = false;
          }
        });
      });
    </script>

    <!-- SPA navigation (disabled for stability) -->
    <!-- <script>
      import '../scripts/spa-navigation.js'
    </script> -->
  </head>

  <body class="font-sans bg-gray-900 text-white" x-data>
    <div class="min-h-screen flex flex-col">

      <!-- NAV -->
      <Nav />

      <!-- CONTENT -->
      <div id="container" class="flex-1">
        <div id="content">
          <slot />
        </div>

        <Footer />
      </div>

    </div>
  </body>
</html>
