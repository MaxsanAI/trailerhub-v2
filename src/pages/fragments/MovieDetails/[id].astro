---
import Modal from '../../../components/Modal.astro';

const { id } = Astro.params;

const url = `https://api.themoviedb.org/3/movie/${id}?append_to_response=credits,videos,images&api_key=${import.meta.env.TMDB_API_KEY}`;

const response = await fetch(url);
const data = await response.json();

const movie = {
  ...data,
  poster_path: data.poster_path
    ? 'https://image.tmdb.org/t/p/w500/' + data.poster_path
    : 'https://via.placeholder.com/500x750',

  vote_average: data.vote_average
    ? (data.vote_average * 10).toFixed(2) + '%'
    : 'N/A',

  release_date: data.release_date
    ? new Date(data.release_date).toLocaleDateString('en-us', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      })
    : 'Unknown',

  genres: data.genres?.map(g => g.name).join(', ') || 'Unknown',

  crew: data.credits?.crew?.slice(0, 3) || [],

  cast: (data.credits?.cast || []).slice(0, 5).map(c => ({
    ...c,
    profile_path: c.profile_path
      ? 'https://image.tmdb.org/t/p/w300/' + c.profile_path
      : 'https://via.placeholder.com/300x450'
  })),

  images: data.images?.backdrops?.slice(0, 9) || [],
};
---

<!-- MOVIE INFO -->
<div class="movie-info border-b border-gray-800">
  <div class="container mx-auto px-4 py-16 flex flex-col md:flex-row">

    <div class="flex-none">
      <img
        src={movie.poster_path}
        alt={`${movie.title} Poster`}
        class="movie-poster w-64 lg:w-96"
        id="movie-poster"
      />
    </div>

    <div class="md:ml-24">

      <h2 class="text-4xl mt-4 md:mt-0 mb-2 font-semibold">
        {movie.title}
      </h2>

      <div class="flex flex-wrap items-center text-gray-400 text-sm">
        <span class="ml-1">{movie.vote_average}</span>
        <span class="mx-2">|</span>
        <span>{movie.release_date}</span>
        <span class="mx-2">|</span>
        <span>{movie.genres}</span>
      </div>

      <p class="text-gray-300 mt-8">
        {movie.overview}
      </p>

      <!-- CREW -->
      <div class="mt-12">
        <h4 class="text-white font-semibold">Featured Crew</h4>

        <div class="flex mt-4">
          {movie.crew.map(crew => (
            <div class="mr-8">
              <div>{crew.name}</div>
              <div class="text-gray-400 text-sm">{crew.job}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- TRAILER -->
      <div x-data="{ isOpen: false }">

        {movie.videos?.results?.length > 0 && (
          <div class="mt-12">
            <button
              @click="isOpen = true"
              class="flex items-center bg-orange-500 text-gray-900 rounded font-semibold px-5 py-4 hover:bg-orange-600 transition"
            >
              <span class="ml-2">Play Trailer</span>
            </button>
          </div>
        )}

        <Modal open="isOpen" close="isOpen = false">
          <div class="relative w-full" style="padding-top: 56.25%">
            <iframe
              class="absolute top-0 left-0 w-full h-full"
              src={`https://www.youtube.com/embed/${movie.videos?.results?.[0]?.key}`}
              style="border:0;"
              allow="autoplay; encrypted-media"
              allowfullscreen
            />
          </div>
        </Modal>

      </div>

    </div>
  </div>
</div>

<!-- CAST -->
<div class="movie-cast border-b border-gray-800">
  <div class="container mx-auto px-4 py-16">

    <h2 class="text-4xl font-semibold">Cast</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8">

      {movie.cast.map(cast => (
        <div class="mt-8">
          <a href={`/people/${cast.id}`}>
            <img
              src={cast.profile_path}
              alt={cast.name}
              class="thumbnail hover:opacity-75 transition"
              id={`person-photo-${cast.id}`}
            />
          </a>

          <div class="mt-2">
            <a href={`/people/${cast.id}`} class="text-lg hover:text-gray-300">
              {cast.name}
            </a>

            <div class="text-sm text-gray-400">
              {cast.character}
            </div>
          </div>
        </div>
      ))}

    </div>
  </div>
</div>

<!-- IMAGES -->
<div class="movie-images" x-data="{ isOpen: false, image: '' }">

  <div class="container mx-auto px-4 py-16">

    <h2 class="text-4xl font-semibold">Images</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">

      {movie.images.map(img => (
        <div class="mt-8">

          <a
            href="#"
            @click.prevent="isOpen = true; image = 'https://image.tmdb.org/t/p/original/' + img.file_path"
          >
            <img
              src={`https://image.tmdb.org/t/p/w500${img.file_path}`}
              loading="lazy"
              class="hover:opacity-75 transition"
            />
          </a>

        </div>
      ))}

    </div>

    <Modal open="isOpen" close="isOpen = false">
      <img :src="image" alt="image" />
    </Modal>

  </div>
</div>
