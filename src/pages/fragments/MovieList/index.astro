---
import MovieCard from '../../../components/MovieCard.astro';

const { genreId } = Astro.props;

const url = genreId
  ? `https://api.themoviedb.org/3/discover/movie?api_key=${import.meta.env.TMDB_API_KEY}&with_genres=${genreId}`
  : `https://api.themoviedb.org/3/movie/popular?api_key=${import.meta.env.TMDB_API_KEY}`;

const response = await fetch(url);
const data = await response.json();
const movies = data.results;
---

<div class="container mx-auto px-4 pt-16 mb-16">
  <div>
    <h2 class="uppercase tracking-wider text-orange-500 text-lg font-semibold">
      {genreId ? 'Genre Movies' : 'Popular Movies'}
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8">
      {movies?.map((movie) => (
        <MovieCard movie={movie} />
      ))}
    </div>
  </div>
</div>
