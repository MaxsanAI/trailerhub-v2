---
const { genre } = Astro.params;

const genreMap = {
  action: 28,
  comedy: 35,
  horror: 27,
  romance: 10749,
  documentary: 99,
};

const genreId = genreMap[genre];

if (!genreId) {
  throw new Error("Invalid genre");
}

const API_KEY = import.meta.env.TMDB_API_KEY;

const res = await fetch(
  `https://api.themoviedb.org/3/discover/movie?api_key=${API_KEY}&with_genres=${genreId}`
);

const data = await res.json();

const movies = (data?.results ?? []).map((m) => ({
  id: m.id,
  title: m.title,
  poster: m.poster_path
    ? `https://image.tmdb.org/t/p/w500${m.poster_path}`
    : "https://via.placeholder.com/500x750?text=No+Image",
  rating: m.vote_average ?? "N/A",
  year: m.release_date ? new Date(m.release_date).getFullYear() : "",
}));
---

<h1 class="text-3xl font-bold mb-6">
  {genre.toUpperCase()}
</h1>

<div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-6">

  {movies.map((movie) => (
    <a
      href={`/fragments/MovieDetails/${movie.id}`}
      data-astro-reload
      class="block bg-black/5 rounded-lg overflow-hidden transform transition hover:scale-[1.03]"
    >

      <!-- POSTER -->
      <div class="aspect-[2/3] w-full overflow-hidden">
        <img
          src={movie.poster}
          alt={movie.title}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>

      <!-- INFO -->
      <div class="p-2">
        <p class="text-sm font-semibold truncate">
          {movie.title}
        </p>

        <p class="text-xs text-gray-400">
          ⭐ {movie.rating}
          {movie.year && ` • ${movie.year}`}
        </p>
      </div>

    </a>
  ))}

</div>
